{
  "name": "yarn-berry-audit-fix",
  "version": "0.2.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "An experimental Yarn Berry audit fixer using temporary resolutions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lockgraph/yarn-berry-audit-fix.git"
  },
  "homepage": "https://github.com/lockgraph/yarn-berry-audit-fix#readme",
  "bugs": {
    "url": "https://github.com/lockgraph/yarn-berry-audit-fix/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=18.12"
  },
  "bin": {
    "yarn-berry-audit-fix": "target/main/cli.js"
  },
  "exports": {
    ".": {
      "types": "./target/main/index.d.ts",
      "import": "./target/main/index.js"
    }
  },
  "files": [
    "target/main",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:test-fixtures": "node --experimental-strip-types src/test/ts/build-fixtures.ts",
    "build:smoke": "tsc -p tsconfig.smoke.json && node --experimental-strip-types src/test/ts/build-smoke.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:quick": "vitest run --exclude \"**/*integration.test.ts\"",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run integration",
    "test:smoke": "node target/smoke/test/ts/smoke.js",
    "check": "npm run build:test-fixtures && npm run typecheck && npm run test:coverage && npm run build",
    "check:quick": "npm run build:test-fixtures && npm run typecheck && npm run test:quick && npm run build && npm run build:smoke && npm run test:smoke",
    "start": "node target/main/cli.js",
    "release": "npx --yes zx-semrel@1.25.1"
  },
  "dependencies": {
    "@yarnpkg/parsers": "^3.0.3",
    "semver": "^7.7.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/semver": "^7.7.1",
    "@vitest/coverage-v8": "^4.1.11",
    "pm-yarn-2": "npm:yarn@2.4.3",
    "pm-yarn-berry-v10": "npm:@yarnpkg/cli-dist@4.18.1",
    "pm-yarn-berry-v5": "npm:@yarnpkg/cli-dist@3.1.1",
    "pm-yarn-berry-v6": "npm:@yarnpkg/cli-dist@3.8.7",
    "pm-yarn-berry-v8": "npm:@yarnpkg/cli-dist@4.13.0",
    "pm-yarn-berry-v9": "npm:@yarnpkg/cli-dist@4.14.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0",
    "yarn-4": "npm:@yarnpkg/cli-dist@4.2.2"
  },
  "license": "MIT"
}
